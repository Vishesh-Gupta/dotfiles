# Homebrew packages. Install with: brew bundle --file Brewfile

# Shell essentials
brew "bat"         # cat with syntax highlighting
brew "eza"         # modern ls
brew "fd"          # fast find, used by fzf
brew "fzf"         # fuzzy finder
brew "ripgrep"     # fast grep
brew "zoxide"      # smarter cd
brew "starship"    # prompt

# Git
brew "git"
brew "gh"
brew "git-delta"   # syntax-highlighted diffs (configured in .config/git/config)

# Dev tooling
brew "mise"        # per-project language versions (node, python, go, ...)
brew "uv"          # Python packages and tools (replaces pip/pipx)
brew "jq"

# Utilities
brew "btop"
brew "glow"
brew "tealdeer"    # tldr pages
brew "zellij"

cask "ghostty"
