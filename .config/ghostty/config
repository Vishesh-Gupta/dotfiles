# Ghostty configuration. Reference: https://ghostty.org/docs/config
# Run `ghostty +validate-config` after editing.

theme = light:Atom One Light,dark:Atom One Dark
font-size = 14
window-padding-x = 8
window-padding-y = 6

# Let Option act as Alt so shell word motions (Alt-b/Alt-f) work.
macos-option-as-alt = true
copy-on-select = clipboard
shell-integration-features = sudo,ssh-terminfo,ssh-env

# Cmd+Left/Right jump by word instead of to line start/end.
keybind = cmd+left=esc:b
keybind = cmd+right=esc:f
